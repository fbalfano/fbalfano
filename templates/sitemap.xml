<?xml version="1.0" encoding="UTF-8"?>
<!--
  XML sitemap template — replace example.com and the <url> entries.
  - <loc>     : absolute URL (must match your canonical, incl. https + trailing slash policy)
  - <lastmod> : ISO 8601 date (YYYY-MM-DD) of last meaningful change
  - <changefreq> / <priority> : hints only; engines may ignore them
  Keep under 50,000 URLs / 50 MB per file; use a sitemap index for larger sites.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://example.com/</loc>
    <lastmod>2026-06-07</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://example.com/about/</loc>
    <lastmod>2026-06-07</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  <!-- Add one <url> block per indexable page -->
</urlset>
