# Copy to /etc/badassai.env (or similar) and reference from the systemd unit.
# NEVER commit the real values.

DJANGO_SECRET_KEY=generate-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=badassai.ca,www.badassai.ca

# Migadu SMTP — hello@badassai.ca is the send-only account.
EMAIL_HOST=smtp.migadu.com
EMAIL_PORT=465
EMAIL_USE_SSL=1
EMAIL_HOST_USER=hello@badassai.ca
EMAIL_HOST_PASSWORD=the-mailbox-password
DEFAULT_FROM_EMAIL=Bad Ass AI <hello@badassai.ca>

# Where contact-form leads get emailed.
CONTACT_RECIPIENT=frank@badassai.ca
